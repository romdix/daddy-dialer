# Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/daddy_dialer

# Long random string. Encrypts the Twilio/Telnyx secrets stored in the database.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

# The public HTTPS address of this app (no trailing slash).
# Twilio calls this URL back, so it must be reachable from the internet.
PUBLIC_URL=https://dialer.example.com

PORT=8080
NODE_ENV=production
