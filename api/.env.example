# Postgres connection string
DATABASE_URL=postgres://user:password@host:5432/romdix_dialer

# Long random string. Encrypts the Twilio/Telnyx secrets stored in the database.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me

PORT=8080
NODE_ENV=production

# ---- Optional -------------------------------------------------------------

# Canonical address for Twilio callbacks (no trailing slash).
# LEAVE BLANK and the app follows whatever domain the request arrived on,
# which is what you want when several domains point at the same server.
PUBLIC_URL=

# Extra hostnames this install answers on (comma separated). Informational only.
PUBLIC_URLS=

# Share the login cookie across subdomains, e.g. .romdix.com
COOKIE_DOMAIN=

# Branding defaults, used only on a fresh install.
# Once you save branding in Settings, these are ignored.
BRAND_NAME=
BRAND_INITIALS=
BRAND_ACCENT=
BRAND_LOGO_URL=
